# ---- API ----
# Comma-separated list of origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:3000

# BestTime.app foot-traffic API — enables the "busy areas" (crowds) factor.
# This is read ONLY by the API (server-side); it is never sent to the web/mobile
# app. Get keys at https://besttime.app. Leave blank to disable the crowds factor.
# After setting it, seed Kraków venues once:  python etl/seed_besttime.py
BESTTIME_API_KEY_PRIVATE=
BESTTIME_API_KEY_PUBLIC=

# ---- Web (Next.js, must be prefixed NEXT_PUBLIC_ to reach the browser) ----
# Base URL of the routing API.
NEXT_PUBLIC_API_URL=http://localhost:8000
# MapLibre style JSON. OpenFreeMap public "liberty" style (no API key).
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
