# Generated data (keep the folder, not its contents).
# The runtime routing data + seeded places DB are committed so a clean clone runs
# without re-running the ETL; the heavy ETL-only inputs stay ignored.
data/*
!data/.gitkeep
!data/nodes.parquet
!data/edges.parquet
!data/edge_sensory.parquet
!data/build_info.json
!data/places.db

# Environment
.env
.env.local

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# OSMnx HTTP cache
etl/cache/

# Node / Next.js
node_modules/
web/.next/
web/out/
web/next-env.d.ts
# MapLibre worker files copied from node_modules by predev/prebuild
web/public/maplibre/

# OS / editor
.DS_Store
